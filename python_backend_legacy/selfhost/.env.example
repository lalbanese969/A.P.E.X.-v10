# A.P.E.X. backend settings — copy this file to ".env" and fill in, then run the backend.
# The real ".env" is git-ignored: NEVER commit your keys/passwords.
#
# The backend reads these as environment variables (see backend/server.py). The run-backend
# scripts and the systemd unit load this file for you.

# Port to listen on (default 8765)
PORT=8765

# Bind address. 0.0.0.0 = reachable on your LAN and through the Cloudflare tunnel.
APEX_HOST=0.0.0.0

# ---- SECURITY -------------------------------------------------------------------------------
# If set, EVERY request to the backend requires this password (HTTP Basic auth), including the
# static files and memory JSON. LEAVE BLANK for local-only testing; SET A STRONG VALUE before
# you expose the box to the internet via the tunnel.
APEX_ACCESS_PASSWORD=

# ---- CLOUD AI KEYS (optional) ---------------------------------------------------------------
# Only needed if you want cloud brains. Leave blank to run Ollama-only (local, private, free).
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Local AI (Ollama) ----------------------------------------------------------------------
# Ollama's host/models are configured in python_backend_legacy/config/ai_center.json, not here
# (default host http://127.0.0.1:11434). See OLLAMA_NOTES.md.
